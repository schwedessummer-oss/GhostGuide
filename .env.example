# =============================================================================
# Ghost Guide environment template. Copy to .env.local for local development.
# Secrets are read only on the server. Only NEXT_PUBLIC_* values reach browsers.
# =============================================================================

# demo = simulated providers allowed (clearly labeled in UI); live = real providers required
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase Postgres in cloud; local Postgres for demo) ----------
# Local:    postgres://postgres:postgres@127.0.0.1:54322/ghostguide
# Supabase: use the transaction pooler connection string (port 6543) and set
#           DATABASE_TRANSACTION_POOLER=true and DATABASE_SSL=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/ghostguide
DATABASE_POOL_MAX=5
DATABASE_TRANSACTION_POOLER=false
DATABASE_SSL=false

# --- Auth --------------------------------------------------------------------
# demo = local demo accounts (local Postgres only); supabase = Supabase Auth
AUTH_PROVIDER=demo
# >= 32 random chars. Signs demo sessions and simulated payment webhooks.  openssl rand -hex 32
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for seeding Supabase Auth users.
SUPABASE_SECRET_KEY=

# --- Payments (Stripe Checkout, test mode) ----------------------------------
# Adapter only (src/integrations/payments): no checkout uses it until Phase 6.
PAYMENTS_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Maps (public; MapLibre GL JS, no API key needed) ---------------------------
# No page shows a map while the hike catalog is rebuilt; the map component reads these.
# Vector basemap style. Default: OpenFreeMap "liberty" (free, OSM data, no key).
NEXT_PUBLIC_MAP_STYLE_URL=
# Terrarium terrain tiles for hillshading (default: AWS Open Data Terrain Tiles). "off" disables.
NEXT_PUBLIC_MAP_TERRAIN_TILES_URL=

# --- Data providers (server-only; no keys required) ----------------------------
# No page calls these: the clients are kept for the offline ingestion pipeline
# (elevation) and for weather, which is hidden for now (docs/PLAN.md §2).
# Identifying User-Agent for provider requests. Their usage policies REQUIRE an
# app name plus a contact URL.
DATA_PROVIDER_USER_AGENT="GhostGuide/1.0 (+https://your-domain.example/contact)"
# Elevation (Terrarium PNG tiles). Free, no key. https://registry.opendata.aws/terrain-tiles/
TERRAIN_TILES_URL=https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png
# Weather clients: MET Norway Locationforecast (global, CC BY 4.0) and NWS alerts (US).
METNO_URL=https://api.met.no/weatherapi
NWS_URL=https://api.weather.gov
# Forecast adapter in src/integrations/weather: demo | nws (api.weather.gov, US only).
WEATHER_PROVIDER=demo
WEATHER_USER_AGENT="GhostGuide/0.1 (+https://your-domain.example/contact)"

# --- Background jobs -----------------------------------------------------------
# Bearer secret required by /api/cron/jobs (Vercel Cron sends it automatically
# when CRON_SECRET is set in the project). >= 16 chars.
CRON_SECRET=
