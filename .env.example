# =============================================================================
# Ghost Guide environment template. Copy to .env.local for local development.
# Secrets are read only on the server. Only NEXT_PUBLIC_* values reach browsers.
# =============================================================================

# demo = simulated providers allowed (clearly labeled in UI); live = real providers required
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
LAUNCH_REGION_SLUG=demo-ghost-ridge

# --- Database (Supabase Postgres in cloud; local Postgres for demo) ----------
# Local:    postgres://postgres:postgres@127.0.0.1:54322/ghostguide
# Supabase: use the transaction pooler connection string (port 6543) and set
#           DATABASE_TRANSACTION_POOLER=true and DATABASE_SSL=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/ghostguide
DATABASE_POOL_MAX=5
DATABASE_TRANSACTION_POOLER=false
DATABASE_SSL=false

# --- Auth --------------------------------------------------------------------
# demo = local demo accounts (local Postgres only); supabase = Supabase Auth
AUTH_PROVIDER=demo
# >= 32 random chars. Signs demo sessions, demo webhooks, share tokens.  openssl rand -hex 32
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for Storage uploads and seeding Supabase Auth users.
SUPABASE_SECRET_KEY=

# --- Object storage (route files, narration audio) ---------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
SUPABASE_STORAGE_BUCKET=trail-media

# --- Payments (Stripe Checkout, test mode) ----------------------------------
PAYMENTS_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Maps --------------------------------------------------------------------
# Optional. Without it the app shows an offline vector route view (no basemap).
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- AI (explanations + summaries of approved content only) ------------------
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Notifications (check-in reminders, overdue notices) ---------------------
# demo = recorded in the audit trail only, never delivered
NOTIFY_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# --- Weather (marketing drafts, pre-hike) -------------------------------------
# nws = api.weather.gov (US only, free). Requires an identifying User-Agent.
WEATHER_PROVIDER=demo
WEATHER_USER_AGENT="GhostGuide/0.1 (ops@your-company.example)"

# --- Background jobs -----------------------------------------------------------
# Bearer secret required by /api/cron/jobs (Vercel Cron sends it automatically
# when CRON_SECRET is set in the project). >= 16 chars.
CRON_SECRET=

LOCATION_RETENTION_DAYS_DEFAULT=30
