# =============================================================================
# Ghost Guide environment template. Copy to .env.local for local development.
# Secrets are read only on the server. Only NEXT_PUBLIC_* values reach browsers.
# =============================================================================

# demo = simulated providers allowed (clearly labeled in UI); live = real providers required
APP_MODE=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000
LAUNCH_REGION_SLUG=demo-ghost-ridge

# --- Database (Supabase Postgres in cloud; local Postgres for demo) ----------
# Local:    postgres://postgres:postgres@127.0.0.1:54322/ghostguide
# Supabase: use the transaction pooler connection string (port 6543) and set
#           DATABASE_TRANSACTION_POOLER=true and DATABASE_SSL=true
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/ghostguide
DATABASE_POOL_MAX=5
DATABASE_TRANSACTION_POOLER=false
DATABASE_SSL=false

# --- Auth --------------------------------------------------------------------
# demo = local demo accounts (local Postgres only); supabase = Supabase Auth
AUTH_PROVIDER=demo
# >= 32 random chars. Signs demo sessions, demo webhooks, share tokens.  openssl rand -hex 32
AUTH_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for Storage uploads and seeding Supabase Auth users.
SUPABASE_SECRET_KEY=

# --- Object storage (route files, narration audio) ---------------------------
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=.data/storage
SUPABASE_STORAGE_BUCKET=trail-media

# --- Payments (Stripe Checkout, test mode) ----------------------------------
PAYMENTS_PROVIDER=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Maps (public; MapLibre GL JS, no API key needed) ---------------------------
# Vector basemap style. Default: OpenFreeMap "liberty" (free, OSM data, no key).
# Swap for MapTiler / Stadia / self-hosted Protomaps by changing this URL.
NEXT_PUBLIC_MAP_STYLE_URL=
# Terrarium terrain tiles for hillshading (default: AWS Open Data Terrain Tiles). "off" disables.
NEXT_PUBLIC_MAP_TERRAIN_TILES_URL=
# Legacy: only used by the fictional demo-region pages until they are migrated.
NEXT_PUBLIC_MAPBOX_TOKEN=

# --- Real trail data & place search (server-only; no keys required) -------------
# Identifying User-Agent for OpenStreetMap (Overpass, Nominatim), MET Norway and
# NWS. Their usage policies REQUIRE an app name plus a contact URL or email.
DATA_PROVIDER_USER_AGENT="GhostGuide/1.0 (+https://your-domain.example; ops@your-company.example)"
# Overpass API endpoints, comma-separated, tried in order. The public instance
# is free but slow at busy times (~30 s per query); for production volume use a
# self-hosted or commercial Overpass instance. Where: https://wiki.openstreetmap.org/wiki/Overpass_API
OVERPASS_URLS=https://overpass-api.de/api/interpreter
# Geocoding (place search). Public Nominatim allows max 1 request/second and no
# autocomplete; results are cached. Where: https://operations.osmfoundation.org/policies/nominatim/
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Elevation profiles (Terrarium PNG tiles). Free, no key. https://registry.opendata.aws/terrain-tiles/
TERRAIN_TILES_URL=https://elevation-tiles-prod.s3.amazonaws.com/terrarium/{z}/{x}/{y}.png
# Recreation.gov RIDB (US federal facilities, campgrounds, permits). Free API key:
# sign in at https://ridb.recreation.gov → Profile → API Keys. Server-only.
RIDB_URL=https://ridb.recreation.gov/api/v1
RIDB_API_KEY=
# Days before loaded trail data is refreshed; tiles requested per search.
CATALOG_TILE_TTL_DAYS=30
CATALOG_MAX_TILES_PER_SEARCH=16
# Start loading missing areas right after a search responds (plus the job runner).
CATALOG_INLINE_INGEST=true
# Show the fictional demo region (development fixtures). Default: on in dev/test,
# off in production. Never enable for real customers.
SHOW_DEMO_FIXTURES=

# --- AI (explanations + summaries of approved content only) ------------------
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# --- Notifications (check-in reminders, overdue notices) ---------------------
# demo = recorded in the audit trail only, never delivered
NOTIFY_PROVIDER=demo
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=

# --- Weather -------------------------------------------------------------------
# Trail pages ALWAYS use real forecasts: MET Norway Locationforecast (global,
# free, CC BY 4.0, requires the identifying User-Agent above) plus official NWS
# alerts for US locations. Base URLs (for self-hosting/tests):
METNO_URL=https://api.met.no/weatherapi
NWS_URL=https://api.weather.gov
# Marketing drafts only: demo | nws (api.weather.gov, US only).
WEATHER_PROVIDER=demo
WEATHER_USER_AGENT="GhostGuide/0.1 (ops@your-company.example)"

# --- Background jobs -----------------------------------------------------------
# Bearer secret required by /api/cron/jobs (Vercel Cron sends it automatically
# when CRON_SECRET is set in the project). >= 16 chars.
CRON_SECRET=

LOCATION_RETENTION_DAYS_DEFAULT=30
