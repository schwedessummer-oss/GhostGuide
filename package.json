{
  "name": "ghost-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "node tests/e2e/run.mjs",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/seed/index.ts",
    "db:reset": "tsx scripts/db/reset.ts",
    "jobs:run": "tsx --conditions=react-server scripts/run-jobs.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup:supabase": "tsx scripts/setup-supabase.ts",
    "vercel:env": "tsx scripts/vercel-env.ts",
    "vercel:secrets": "tsx scripts/vercel-env.ts --secrets-only",
    "setup:cron": "tsx scripts/setup-cron.ts",
    "db:seed:catalog-fixtures": "tsx --conditions=react-server scripts/dev/seed-catalog-fixtures.ts"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "mapbox-gl": "^3.34.2",
    "maplibre-gl": "^6.18.0",
    "next": "16.4.5",
    "pngjs": "^7.0.0",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
